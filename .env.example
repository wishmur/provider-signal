# ProviderSignal local environment (copy to .env; .env is git-ignored; never commit a key)
# Anthropic Console API key. Server-side only. Required for AI_MODE=live.
ANTHROPIC_API_KEY=
# Embedded model. Exact identifier confirmed against official SDK documentation before Phase 2.
ANTHROPIC_MODEL=claude-sonnet-5
# Effort level for the evidence brief: medium by default; high compared in Phase 2.
ANTHROPIC_EFFORT=medium
# live | cached | off. Public deployment runs cached with no key.
AI_MODE=cached
# Hard ceiling on live calls per running instance (courtesy control for local runs only).
AI_MAX_CALLS_PER_DEPLOYMENT=
# Upper bound on output tokens per evidence brief.
AI_MAX_TOKENS=
